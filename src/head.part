<!DOCTYPE html>
<html lang="de">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no, viewport-fit=cover">
<meta name="theme-color" content="#1b1035">
<title>Einsatz-Duell</title>
<style>
@font-face{font-family:"Bangers";src:url(data:font/woff2;base64,__FONT__) format("woff2");font-display:swap}
:root{
  --ink:#111;--paper:#fff8e7;--bg:#1b1035;--bg2:#2c1a57;
  --red:#ff3b3b;--yellow:#ffd23f;--blue:#3fa9ff;--green:#3ddc84;--purple:#a463ff;--orange:#ff8c2b;
  --comic:"Bangers",Impact,"Arial Black",sans-serif;
  --body:system-ui,-apple-system,"Segoe UI",Roboto,sans-serif;
}
*{box-sizing:border-box;-webkit-tap-highlight-color:transparent}
html,body{margin:0;height:100%;background:var(--bg);color:var(--paper);font-family:var(--body);overscroll-behavior:none}
body{background:
  radial-gradient(circle at 1px 1px,rgba(255,255,255,.07) 1.2px,transparent 1.5px) 0 0/10px 10px,
  linear-gradient(160deg,var(--bg2),var(--bg));min-height:100%;user-select:none}
button{font-family:var(--comic);letter-spacing:1px;font-size:18px;border:3px solid var(--ink);border-radius:12px;
  padding:10px 16px;background:var(--yellow);color:var(--ink);box-shadow:4px 4px 0 var(--ink);cursor:pointer}
button:active{transform:translate(3px,3px);box-shadow:1px 1px 0 var(--ink)}
button:disabled{opacity:.4;pointer-events:none}
button.red{background:var(--red);color:#fff}
button.blue{background:var(--blue)}
button.green{background:var(--green)}
button.ghost{background:#fff;}
button.small{font-size:14px;padding:6px 10px;box-shadow:3px 3px 0 var(--ink)}
input,select,textarea{font-family:var(--body);font-size:16px;width:100%;padding:9px;border:3px solid var(--ink);border-radius:10px;background:#fff;color:var(--ink)}
label{display:block;font-family:var(--comic);letter-spacing:1px;font-size:15px;margin:10px 0 4px;color:var(--yellow)}
h1,h2,h3{font-family:var(--comic);letter-spacing:2px;margin:0}
.screen{display:none;min-height:100vh;padding:calc(env(safe-area-inset-top) + 12px) 12px calc(env(safe-area-inset-bottom) + 16px)}
.screen.active{display:block}
.topbar{display:flex;align-items:center;gap:10px;margin-bottom:12px}
.topbar h2{font-size:28px;flex:1;color:var(--yellow);-webkit-text-stroke:1px var(--ink);text-shadow:3px 3px 0 var(--ink)}
.row{display:flex;gap:8px;flex-wrap:wrap}
.grid2{display:grid;grid-template-columns:1fr 1fr;gap:8px}
.panel{background:rgba(0,0,0,.25);border:3px solid var(--ink);border-radius:14px;padding:12px;margin-bottom:12px}
.muted{opacity:.7;font-size:13px}

/* ---------- HOME ---------- */
#home{display:none;flex-direction:column;align-items:center;justify-content:center;text-align:center}
#home.active{display:flex}
.logo{font-family:var(--comic);font-size:58px;line-height:.9;color:var(--yellow);-webkit-text-stroke:2px var(--ink);
  text-shadow:5px 5px 0 var(--red),9px 9px 0 var(--ink);transform:rotate(-4deg);margin:10px 0 6px}
.logo small{display:block;font-size:30px;color:#fff;text-shadow:3px 3px 0 var(--blue),6px 6px 0 var(--ink)}
.burst{position:relative;display:inline-block;padding:8px 18px;background:var(--red);color:#fff;font-family:var(--comic);
  border:3px solid var(--ink);transform:rotate(3deg);margin-bottom:28px;box-shadow:4px 4px 0 var(--ink)}
.menu{display:flex;flex-direction:column;gap:14px;width:min(320px,90vw)}
.menu button{font-size:24px;padding:14px}

/* ---------- CARD ---------- */
.card{--w:150px;width:var(--w);aspect-ratio:59/86;position:relative;border:calc(var(--w)*.025) solid var(--ink);border-radius:calc(var(--w)*.06);
  background:var(--frame,#e8a33d);padding:calc(var(--w)*.045);display:flex;flex-direction:column;gap:calc(var(--w)*.03);
  color:var(--ink);box-shadow:calc(var(--w)*.03) calc(var(--w)*.03) 0 var(--ink);overflow:hidden;flex-shrink:0}
.card .nm{font-family:var(--comic);font-size:calc(var(--w)*.105);letter-spacing:.3px;background:var(--paper);border:2px solid var(--ink);
  border-radius:4px;padding:1px 3px;white-space:nowrap;display:flex;justify-content:space-between;align-items:center;gap:2px;min-height:calc(var(--w)*.135)}
.card .nm .nmt{flex:1;min-width:0;line-height:1.05}
.card .nm.two .nmt{white-space:normal;line-height:.98;hyphens:manual;overflow-wrap:anywhere}
.card .nm .at{font-size:.8em;flex-shrink:0;margin-left:3px}
.card .lv{font-size:calc(var(--w)*.075);text-align:right;line-height:1;height:calc(var(--w)*.08);color:#c00;text-shadow:0 0 1px #000}
.card .art{flex:1;border:2px solid var(--ink);border-radius:4px;position:relative;overflow:hidden;
  background:radial-gradient(circle at 1px 1px,rgba(0,0,0,.25) 1px,transparent 1.3px) 0 0/6px 6px,linear-gradient(135deg,var(--c1,#ff6),var(--c2,#f60));
  display:flex;align-items:center;justify-content:center;font-size:calc(var(--w)*.38)}
.card .art img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
.card .art .rar{position:absolute;top:2px;left:3px;font-family:var(--comic);font-size:calc(var(--w)*.075);color:#fff;-webkit-text-stroke:.5px #000;text-shadow:1px 1px 0 #000}
.card .tx{background:var(--paper);border:2px solid var(--ink);border-radius:4px;padding:2px 4px;font-size:calc(var(--w)*.06);line-height:1.15;height:calc(var(--w)*.32);overflow:hidden}
.card .tx b{font-family:var(--comic);letter-spacing:.4px;font-weight:normal}
.card .st{font-family:var(--comic);font-size:calc(var(--w)*.085);display:flex;justify-content:flex-end;gap:8px;line-height:1}
.card.f-polizei{--frame:#2b6cd6}
.card.f-verbrecher{--frame:#b3261e}
.card.l-StPO{--frame:#2f8f4e}
.card.l-SOG{--frame:#127a8a}
.card.l-Trick{--frame:#6b2fa3}
.card.trap{background:repeating-linear-gradient(45deg,var(--frame) 0 10px,color-mix(in srgb,var(--frame) 80%,#000) 10px 20px)}
.card .lawtag{font-family:var(--comic);font-size:calc(var(--w)*.07);color:#fff;background:var(--ink);padding:0 4px;border-radius:3px;letter-spacing:.5px;text-shadow:none}
.card.f-polizei .nm,.card.f-verbrecher .nm{color:var(--ink)}
.side-pick{display:grid;grid-template-columns:1fr 1fr;gap:10px;width:100%}
.side-pick button{font-size:22px;padding:18px 8px;display:flex;flex-direction:column;align-items:center;gap:6px}
.side-pick button span{font-size:44px}
.card .rar .gem{display:inline-block;width:calc(var(--w)*.05);height:calc(var(--w)*.05);border-radius:50%;border:1px solid #000;margin-right:2px;vertical-align:middle}
/* ===== Seltenheitsstufen (pro Exemplar, nur optisch) ===== */
/* Rare: Silberfolie im Namensfeld */
.card.p-R .nm,.card.p-SP .nm{background:linear-gradient(110deg,#d9dee4 0%,#fff 20%,#aeb7c2 38%,#fff 55%,#c9d0d8 75%,#fff 100%);background-size:220% 100%;animation:foil 4s linear infinite}
@keyframes foil{from{background-position:0 0}to{background-position:-220% 0}}
/* Special Rare: Holo-Glanz über dem Bild + Silberkante */
.card.p-SP{box-shadow:calc(var(--w)*.03) calc(var(--w)*.03) 0 var(--ink),inset 0 0 0 calc(var(--w)*.012) #f2f2f2}
.card.p-SP .art::after,.card.p-SE .art::before,.card.p-LG .art::before{content:"";position:absolute;inset:0;pointer-events:none;
  background:linear-gradient(115deg,transparent 30%,rgba(255,255,255,.65) 45%,transparent 60%);background-size:250% 100%;animation:shine 3s infinite linear}
/* Secret Rare: Regenbogen-Prisma + Funkeln + Regenbogenschrift */
.card.p-SE{box-shadow:calc(var(--w)*.03) calc(var(--w)*.03) 0 var(--ink),0 0 calc(var(--w)*.06) rgba(255,120,255,.7)}
.card.p-SE .art::after{content:"";position:absolute;inset:0;pointer-events:none;mix-blend-mode:color-dodge;opacity:.75;
  background:linear-gradient(125deg,#ff004c,#ffd300,#00ff95,#00c8ff,#b400ff,#ff004c);background-size:400% 400%;animation:prism 5s linear infinite}
.card.p-SE .nm .nmt{background:linear-gradient(90deg,#e3001b,#ff8c00,#e6b800,#00a651,#0072ff,#7a00ff,#e3001b);background-size:200% 100%;-webkit-background-clip:text;background-clip:text;color:transparent;animation:foil 3s linear infinite}
.card.p-SE .tx::after{content:"✦";position:absolute;right:4%;top:-6%;color:#fff;font-size:calc(var(--w)*.09);text-shadow:0 0 4px #ff6bff;animation:twinkle 1.6s ease-in-out infinite}
.card .tx{position:relative}
@keyframes prism{from{background-position:0% 50%}to{background-position:400% 50%}}
@keyframes twinkle{0%,100%{opacity:.2;transform:scale(.6)}50%{opacity:1;transform:scale(1.2)}}
/* Ghost Rare: geisterhaft, entsättigt, Nebel und kühles Leuchten */
.card.p-GH{box-shadow:calc(var(--w)*.03) calc(var(--w)*.03) 0 var(--ink),0 0 calc(var(--w)*.1) rgba(200,230,255,.95);animation:ghostfloat 3.2s ease-in-out infinite}
.card.p-GH .art{filter:grayscale(.9) brightness(1.3) contrast(.85)}
.card.p-GH .art>*:not(.rar){opacity:.8}
.card.p-GH .art::after{content:"";position:absolute;inset:-20%;pointer-events:none;background:radial-gradient(circle at 30% 40%,rgba(230,245,255,.75),transparent 45%),radial-gradient(circle at 70% 70%,rgba(200,225,255,.6),transparent 40%);animation:mist 6s ease-in-out infinite alternate}
.card.p-GH .nm{background:#f4fbff;box-shadow:0 0 calc(var(--w)*.04) #cde8ff}
.card.p-GH .nm .nmt{color:#2c4b66;text-shadow:0 0 calc(var(--w)*.03) #bfe3ff}
@keyframes mist{from{transform:translate(-6%,-4%)}to{transform:translate(6%,5%)}}
@keyframes ghostfloat{0%,100%{filter:drop-shadow(0 0 0 rgba(200,230,255,0))}50%{filter:drop-shadow(0 0 calc(var(--w)*.06) rgba(200,230,255,.9))}}
/* Legendary: Goldrahmen, pulsierende Glut, aufsteigende Funken */
.card.p-LG{background:linear-gradient(135deg,#7a4b00,#ffd76a 28%,#b8860b 48%,#fff2b0 68%,#8a5a00) !important;animation:lgglow 1.8s ease-in-out infinite alternate}
@keyframes lgglow{from{box-shadow:calc(var(--w)*.03) calc(var(--w)*.03) 0 var(--ink),0 0 calc(var(--w)*.04) #ffb300}to{box-shadow:calc(var(--w)*.03) calc(var(--w)*.03) 0 var(--ink),0 0 calc(var(--w)*.14) #ff7a00}}
.card.p-LG .nm{background:linear-gradient(110deg,#fff3c4,#ffd76a 30%,#fff8de 50%,#e0a92e 70%,#fff3c4);background-size:220% 100%;animation:foil 2.5s linear infinite}
.card.p-LG .art::after{content:"";position:absolute;inset:0;pointer-events:none;
  background:radial-gradient(circle,#ffe08a 0 1.5px,transparent 2px) 10% 100%/22% 30%,radial-gradient(circle,#ff9d2e 0 1.2px,transparent 1.8px) 60% 100%/28% 34%,radial-gradient(circle,#fff3b0 0 1px,transparent 1.6px) 85% 100%/18% 26%;
  animation:embers 2.2s linear infinite;mix-blend-mode:screen}
.card.p-LG .rar::before{content:"★";margin-right:1px;color:#ffd23f}
@keyframes embers{from{background-position:10% 110%,60% 120%,85% 105%}to{background-position:14% -30%,56% -40%,88% -35%}}
.prname{font-family:var(--comic);letter-spacing:1px;font-size:14px;text-align:center;margin-top:4px}
.pn-R{color:#d9dee4}.pn-SP{color:#fff}.pn-SE{background:linear-gradient(90deg,#ff5a7a,#ffd300,#00e08a,#3fa9ff,#c06bff);-webkit-background-clip:text;color:transparent}
.pn-GH{color:#cfeaff;text-shadow:0 0 6px #9fd4ff}.pn-LG{color:#ffd23f;text-shadow:0 0 8px #ff8c2b}
@keyframes shine{from{background-position:150% 0}to{background-position:-100% 0}}
.cardback{--w:150px;width:var(--w);aspect-ratio:59/86;border:calc(var(--w)*.025) solid var(--ink);border-radius:calc(var(--w)*.06);flex-shrink:0;
  background:radial-gradient(circle,#ffd23f 0 18%,var(--ink) 19% 22%,transparent 23%),
  repeating-conic-gradient(#2b6cd6 0 15deg,#173f8a 15deg 30deg);box-shadow:calc(var(--w)*.03) calc(var(--w)*.03) 0 var(--ink)}

/* ---------- ADMIN ---------- */
.cardlist{display:grid;grid-template-columns:repeat(auto-fill,minmax(100px,1fr));gap:12px;justify-items:center}
.cardlist .card{--w:100px}
.editor{display:grid;gap:12px}
@media(min-width:700px){.editor{grid-template-columns:240px 1fr}}
.preview-wrap{display:flex;justify-content:center;position:sticky;top:8px;align-self:start;z-index:2}
.preview-wrap .card{--w:210px}
.stats-row{display:grid;grid-template-columns:1fr 1fr 1fr;gap:8px}
.chips{display:flex;gap:6px;flex-wrap:wrap}
.chips span{padding:6px 10px;border:3px solid var(--ink);border-radius:20px;background:#fff;color:var(--ink);font-family:var(--comic);letter-spacing:1px;font-size:14px}
.chips span.on{background:var(--yellow)}
.emoji-pick{display:flex;flex-wrap:wrap;gap:4px;font-size:24px}
.emoji-pick span{padding:2px 4px;border-radius:6px;background:rgba(255,255,255,.1)}
.filterbar{display:flex;gap:6px;margin-bottom:10px}
.filterbar input{flex:1}
.filterbar select{width:auto}

/* ---------- DECK ---------- */
.deckcount{font-family:var(--comic);font-size:22px;letter-spacing:1px}
.deckitem{position:relative}
.deckitem .cnt{position:absolute;top:-8px;right:-6px;background:var(--red);color:#fff;border:2px solid var(--ink);border-radius:50%;
  width:28px;height:28px;display:flex;align-items:center;justify-content:center;font-family:var(--comic);font-size:16px;z-index:2}
.deckitem .ctrl{display:flex;gap:4px;justify-content:center;margin-top:6px}
.deckitem .ctrl button{padding:2px 10px;font-size:18px;box-shadow:2px 2px 0 var(--ink)}

/* ---------- DUEL ---------- */
#duel{padding:calc(env(safe-area-inset-top) + 6px) 6px calc(env(safe-area-inset-bottom) + 6px);height:100vh;overflow:hidden;display:none;flex-direction:column}
#duel.active{display:flex}
.lpbar{display:flex;align-items:center;gap:8px;padding:4px 8px;background:rgba(0,0,0,.35);border:3px solid var(--ink);border-radius:12px}
.lpbar .who{font-family:var(--comic);font-size:18px;letter-spacing:1px;flex:1}
.lpbar .lp{font-family:var(--comic);font-size:26px;color:var(--yellow);-webkit-text-stroke:1px var(--ink);text-shadow:2px 2px 0 var(--ink)}
.lpbar .pile{font-size:12px;opacity:.8;text-align:right}
.field{flex:1;display:flex;flex-direction:column;justify-content:center;gap:6px;padding:6px 0}
.zones{display:flex;justify-content:center;gap:8px}
.zone{--w:min(19vw,13vh,96px);width:var(--w);aspect-ratio:59/86;border:2px dashed rgba(255,255,255,.3);border-radius:8px;display:flex;align-items:center;justify-content:center;position:relative}
.zone .card,.zone .cardback{--w:min(19vw,13vh,96px)}
.zone .card.def,.zone .cardback.def{transform:rotate(90deg) scale(.8)}
.zone.st .card,.zone.st .cardback{--w:min(14vw,9vh,70px)}
.zone.st{--w:min(14vw,9vh,70px)}
.zone .card.used{filter:grayscale(.6) brightness(.8)}
.zone.target{border:3px solid var(--red);animation:pulse .8s infinite alternate}
.zone.tribute{border:3px solid var(--purple);animation:pulse .8s infinite alternate}
.zone.sel{border:3px solid var(--yellow)}
@keyframes pulse{to{box-shadow:0 0 14px var(--red)}}
.divider{display:flex;align-items:center;justify-content:center;gap:8px;margin:2px 0}
.phase{font-family:var(--comic);letter-spacing:1px;padding:3px 10px;border:2px solid var(--ink);border-radius:8px;background:var(--blue);color:var(--ink);font-size:14px}
.direct{display:none}
.direct.show{display:inline-block}
.hand{display:flex;justify-content:center;gap:0;height:min(27vw,15vh,140px);padding:0 10px;margin-top:4px}
.hand .card{--w:min(19vw,10.5vh,96px);margin:0 -6px;transition:transform .15s}
.hand .card.playable{outline:3px solid var(--green);outline-offset:-2px}
.hand .card:active{transform:translateY(-10px)}
.opphand{display:flex;justify-content:center;height:min(10vw,5vh,40px);overflow:hidden}
.opphand .cardback{--w:min(9vw,4.8vh,38px);margin:0 -3px}
.duelctrl{display:flex;gap:8px;justify-content:space-between;align-items:center;margin-top:4px}
.log{font-size:12px;opacity:.85;flex:1;text-align:center;min-height:2.4em;line-height:1.2}

/* ---------- MODAL ---------- */
.modal{position:fixed;inset:0;background:rgba(10,5,25,.85);display:none;align-items:center;justify-content:center;z-index:50;padding:16px}
.modal.show{display:flex}
.modal .box{display:flex;flex-direction:column;align-items:center;gap:14px;max-width:420px;width:100%}
.modal .box .card{--w:min(62vw,40vh,260px)}
.modal .acts{display:flex;flex-direction:column;gap:8px;width:min(300px,85vw)}
.banner{position:fixed;left:50%;top:40%;transform:translate(-50%,-50%) rotate(-6deg);font-family:var(--comic);font-size:52px;color:var(--yellow);
  -webkit-text-stroke:2px var(--ink);text-shadow:5px 5px 0 var(--red),8px 8px 0 var(--ink);z-index:60;pointer-events:none;opacity:0;white-space:nowrap}
.banner.show{animation:pop 1.1s ease-out}
@keyframes pop{0%{opacity:0;transform:translate(-50%,-50%) rotate(-6deg) scale(.3)}20%{opacity:1;transform:translate(-50%,-50%) rotate(-6deg) scale(1.15)}
  80%{opacity:1;transform:translate(-50%,-50%) rotate(-6deg) scale(1)}100%{opacity:0;transform:translate(-50%,-50%) rotate(-6deg) scale(1)}}
.toast{position:fixed;bottom:calc(env(safe-area-inset-bottom) + 20px);left:50%;transform:translateX(-50%);background:var(--paper);color:var(--ink);
  border:3px solid var(--ink);border-radius:12px;padding:10px 16px;font-weight:700;z-index:70;box-shadow:4px 4px 0 var(--ink);display:none;max-width:90vw;text-align:center}
.toast.show{display:block}
.shake{animation:shake .35s}
@keyframes shake{25%{transform:translateX(-6px)}50%{transform:translateX(6px)}75%{transform:translateX(-3px)}}
